rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'message', 'level', 'audience', 'status', 'createdAt', 'updatedAt', 'publishedAt', 'authorId'])
        && d.keys().hasOnly(['title', 'message', 'level', 'audience', 'status', 'createdAt', 'updatedAt', 'publishedAt', 'authorId'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.message is string && d.message.size() > 0 && d.message.size() <= 1000
        && d.level in ['info', 'success', 'urgent']
        && d.audience in ['all', 'html', 'css', 'js']
        && d.status in ['published', 'draft']
        && d.createdAt is timestamp && d.publishedAt is timestamp
        && d.authorId is string && d.updatedAt == request.time;
    }

    /* Comunicados publicados podem ser lidos por alunos autenticados;
       criar, editar e remover exige a custom claim admin. */
    match /announcements/{announcementId} {
      allow read: if request.auth != null && (resource.data.status == 'published' || isAdmin());
      allow create: if isAdmin() && validAnnouncement()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.publishedAt == request.time;
      allow update: if isAdmin() && validAnnouncement()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.publishedAt == resource.data.publishedAt;
      allow delete: if isAdmin();
    }

    /* users/{uid} -> perfil do aluno.
       Só o próprio usuário autenticado (uid do Firebase Auth igual
       ao id do documento) pode ler ou escrever seus dados. Ninguém
       lê o perfil de outra pessoa. */
    match /users/{userId} {
      // Modelo local: somente leitura/limpeza de dados legados. Sem novas escritas.
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      /* users/{uid}/progress/{progressId} -> progresso de aulas/cursos */
      match /progress/{progressId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
      }

      /* users/{uid}/exercises/{exerciseId} -> código salvo na IDE */
      match /exercises/{exerciseId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* Qualquer outra coleção/documento não previsto acima fica
       bloqueado por padrão (nega tudo). */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
